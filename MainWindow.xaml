<Window x:Class="NakisCAD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NakisCAD.App"
        Title="NakisCAD - Endustriyel Nakis Yazilimi" 
        Height="800" Width="1400"
        Background="#1E1E1E"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- DARK THEME RESOURCES -->
        <SolidColorBrush x:Key="BgDark" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="BgMedium" Color="#16213E"/>
        <SolidColorBrush x:Key="BgPanel" Color="#0F3460"/>
        <SolidColorBrush x:Key="BgToolbar" Color="#1A1A2E"/>
        <SolidColorBrush x:Key="BgInput" Color="#16213E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#00D4FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9100"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF5252"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#616161"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2A2A4A"/>
        <SolidColorBrush x:Key="BorderLight" Color="#3A3A5A"/>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource BgDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource BgMedium}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource BgMedium}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewProjectCmd}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static local:MainWindow.OpenDstCmd}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{x:Static local:MainWindow.LoadImageCmd}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{x:Static local:MainWindow.AutoDigitizeCmd}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveCmd}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveAsCmd}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.AutoDigitizeCmd}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInCmd}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutCmd}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomFitCmd}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static local:MainWindow.Zoom100Cmd}"/>
        <KeyBinding Key="G" Modifiers="Control" Command="{x:Static local:MainWindow.ToggleGridCmd}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{x:Static local:MainWindow.ExportDstCmd}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== MENU BAR ==================== -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Dosya">
                <MenuItem Header="_Yeni Proje" Click="OnNewProject" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_DST Dosyasi Ac..." Click="OnOpenDst" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Goruntu Yukle (PNG/JPG)..." Click="OnLoadImage" InputGestureText="Ctrl+I"/>
                <MenuItem Header="_Otomatik Digitize Et" Click="OnAutoDigitize" InputGestureText="Ctrl+D"/>
                <Separator/>
                <MenuItem Header="Son Acilanlar" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="_Kaydet" Click="OnSave" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Farkli Kaydet..." Click="OnSaveAs" InputGestureText="Ctrl+Shift+S"/>
                <MenuItem Header="DST Olustur (Ornek)" Click="OnCreateSample"/>
                <Separator/>
                <MenuItem Header="Cikis" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Duzenle">
                <MenuItem Header="Geri Al" InputGestureText="Ctrl+Z" IsEnabled="False"/>
                <MenuItem Header="Yinele" InputGestureText="Ctrl+Y" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Tumunu Sec" InputGestureText="Ctrl+A" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Gorunum">
                <MenuItem Header="TrueView (3D)" IsCheckable="True" IsChecked="False" Click="OnToggleTrueView"/>
                <MenuItem Header="Dikisleri Goster" IsCheckable="True" IsChecked="True" Click="OnToggleStitches"/>
                <MenuItem Header="Hatlari Goster" IsCheckable="True" IsChecked="True" Click="OnToggleOutlines"/>
                <MenuItem Header="Baglanti Noktalari" IsCheckable="True" IsChecked="False"/>
                <Separator/>
                <MenuItem Header="Grid Goster" IsCheckable="True" IsChecked="True" Click="OnToggleGrid"/>
                <MenuItem Header="Cizgiler Goster" IsCheckable="True" IsChecked="True"/>
                <Separator/>
                <MenuItem Header="Yakinlastir" Click="OnZoomIn" InputGestureText="Ctrl++"/>
                <MenuItem Header="Uzaklastir" Click="OnZoomOut" InputGestureText="Ctrl+-"/>
                <MenuItem Header="Tumunu Gorecek Sekilde" Click="OnZoomFit" InputGestureText="Ctrl+0"/>
                <MenuItem Header="1:1 Olcekleme" Click="OnZoom100" InputGestureText="Ctrl+1"/>
            </MenuItem>
            <MenuItem Header="_Araclar">
                <MenuItem Header="DST Analiz Et" Click="OnDstAnalysis"/>
                <MenuItem Header="Dikis Sayisi Hesapla" Click="OnCountStitches"/>
                <MenuItem Header="Yoğunluk Haritasi" Click="OnDensityMap" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Ayarlar..." Click="OnSettings" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="Makine">
                <MenuItem Header="FORTEVER FT-1201" IsEnabled="False"/>
                <MenuItem Header="Tajima" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Makine Baglantisi" Click="OnMachineConnect" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Yardim">
                <MenuItem Header="Dokumantasyon" IsEnabled="False"/>
                <MenuItem Header="Kisayol Tuslari" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Hakkinda" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- ==================== MAIN TOOLBAR ==================== -->
        <Border Grid.Row="1" Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Left: File Operations -->
                <WrapPanel DockPanel.Dock="Left" Margin="4,2">
                    <Button Content="Yeni" Click="OnNewProject" ToolTip="Yeni Proje (Ctrl+N)" Width="55"/>
                    <Button Content="Ac" Click="OnOpenDst" ToolTip="DST Ac (Ctrl+O)" Width="55"/>
                    <Button Content="Kaydet" Click="OnSave" ToolTip="Kaydet (Ctrl+S)" Width="60"/>
                    <Border Width="1" Background="{StaticResource BorderDark}" Margin="4,2"/>
                    <Button Content="Geri" Width="45" IsEnabled="False"/>
                    <Button Content="Ileri" Width="45" IsEnabled="False"/>
                    <Border Width="1" Background="{StaticResource BorderDark}" Margin="4,2"/>
                    <Button Content="Kes" Width="45" IsEnabled="False"/>
                    <Button Content="Kopyala" Width="55" IsEnabled="False"/>
                    <Button Content="Yapistir" Width="55" IsEnabled="False"/>
                </WrapPanel>

                <!-- Right: View Controls -->
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="4,2">
                    <Button Content="TrueView" Click="OnToggleTrueView" Width="70" ToolTip="3D Gorunum"/>
                    <Button Content="Grid" Click="OnToggleGrid" Width="50" ToolTip="Grid Goster/Gizle"/>
                    <Border Width="1" Background="{StaticResource BorderDark}" Margin="4,2"/>
                    <Button Content="Zoom+" Click="OnZoomIn" Width="45"/>
                    <Button Content="Zoom-" Click="OnZoomOut" Width="45"/>
                    <Button Content="Fit" Click="OnZoomFit" Width="40"/>
                    <Button Content="1:1" Click="OnZoom100" Width="40"/>
                    <Border Width="1" Background="{StaticResource BorderDark}" Margin="4,2"/>
                    <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="txtZoomLevel" Text="100%" VerticalAlignment="Center" Width="45" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                </WrapPanel>

                <!-- Center: Stitch Types -->
                <WrapPanel DockPanel.Dock="Left" Margin="4,2" VerticalAlignment="Center">
                    <TextBlock Text="Dikiş Tipleri:" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                    <Button Content="Run" ToolTip="Cizgi Dikisi" Width="50" Background="#1B5E20"/>
                    <Button Content="Satin" ToolTip="Saten Dikisi" Width="50" Background="#B71C1C"/>
                    <Button Content="Tatami" ToolTip="Tatami Dolgu" Width="55" Background="#1A237E"/>
                    <Button Content="Zigzag" ToolTip="Zigzag" Width="55" Background="#4A148C"/>
                    <Button Content="E-Stitch" ToolTip="E-Dikisi" Width="60" Background="#E65100"/>
                    <Button Content="Motif" ToolTip="Motif Dolgu" Width="50" Background="#004D40" IsEnabled="False"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN CONTENT ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT ICON TOOLBOX ===== -->
            <Border Grid.Column="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                <StackPanel Margin="2,8,2,2">
                    <TextBlock Text="ARAÇLAR" FontSize="8" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    
                    <Button ToolTip="Sec" Width="44" Height="44" Click="OnToolSelect">
                        <TextBlock Text="⬚" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Duzenle (Node)" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="✎" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderDark}" Margin="2,6"/>
                    <TextBlock Text="GÖRÜNTÜDEN" FontSize="8" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,4"/>

                    <Button ToolTip="Goruntu Yukle (PNG/JPG)" Width="44" Height="44" Click="OnLoadImage" Background="#E65100">
                        <TextBlock Text="📷" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Otomatik Digitize Et" Width="44" Height="44" Click="OnAutoDigitize" Background="#BF360C">
                        <TextBlock Text="⚡" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderDark}" Margin="2,6"/>
                    <TextBlock Text="DIGITIZE" FontSize="8" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,4"/>

                    <Button ToolTip="Acik Sekil Ciz" Width="44" Height="44" Click="OnDigitizeOpen" Background="#0D47A1">
                        <TextBlock Text="╱" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Kapali Sekil Ciz" Width="44" Height="44" Click="OnDigitizeClosed" Background="#1565C0">
                        <TextBlock Text="◇" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Dikdortgen" Width="44" Height="44" Click="OnDigitizeRect" Background="#1976D2">
                        <TextBlock Text="▭" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Daire" Width="44" Height="44" Click="OnDigitizeCircle" Background="#1E88E5">
                        <TextBlock Text="○" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Serbest Cizim" Width="44" Height="44" Click="OnDigitizeFreehand" Background="#2196F3">
                        <TextBlock Text="〰" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Saten Kolon" Width="44" Height="44" Click="OnDigitizeSatinCol" Background="#42A5F5">
                        <TextBlock Text="⫿" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderDark}" Margin="2,6"/>
                    <TextBlock Text="DÜZENLE" FontSize="8" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,4"/>

                    <Button ToolTip="Kes" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="✂" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Kopyala" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="⧉" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Dondur" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="↻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Aynala" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="↔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Olcekle" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="⇔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Border Height="1" Background="{StaticResource BorderDark}" Margin="2,6"/>
                    <TextBlock Text="OZEL" FontSize="8" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,4"/>

                    <Button ToolTip="Alt Dikisi" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="≋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Pull Compensation" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="⇔+" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Smart Corner" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="∠" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button ToolTip="Dallanma (Branching)" Width="44" Height="44" IsEnabled="False">
                        <TextBlock Text="⌘" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== LEFT PANEL: FILE INFO + LAYERS ===== -->
            <Border Grid.Column="1" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                <TabControl>
                    <!-- TAB: DOSYA BILGILERI -->
                    <TabItem Header="Bilgiler">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                            <StackPanel>
                                <TextBlock Text="DESAIN BILGISI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,8"/>

                                <Label Content="Desen Adi:"/>
                                <TextBox x:Name="txtDesignName" IsReadOnly="True"/>

                                <Label Content="Toplam Dikis:"/>
                                <TextBox x:Name="txtTotalStitches" IsReadOnly="True"/>

                                <Label Content="Renk Degisimi:"/>
                                <TextBox x:Name="txtColorChanges" IsReadOnly="True"/>

                                <Label Content="Genislik (mm):"/>
                                <TextBox x:Name="txtWidth" IsReadOnly="True"/>

                                <Label Content="Yukseklik (mm):"/>
                                <TextBox x:Name="txtHeight" IsReadOnly="True"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="DIKIS DAGILIMI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,8,0,6"/>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Normal Dikis" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="txtNormalCount" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Jump Dikis" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="txtJumpCount" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Renk Degisim" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="txtColorChangeCount" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bitis" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Grid.Column="1" x:Name="txtEndCount" Foreground="{StaticResource TextPrimary}" FontWeight="Bold"/>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="DOSYA YOLU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" Margin="0,8,0,6"/>
                                <TextBlock x:Name="txtFilePath" Text="Acilmadi" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB: RENK-OBJE LISTESI -->
                    <TabItem Header="Renk/Obje">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="RENK-OBJE LISTESI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="8,8,8,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="Siralama ve grup yonetimi" Foreground="{StaticResource TextMuted}" FontSize="9" Margin="8,0,8,4"/>
                            
                            <ListView x:Name="lstColorObjects" Margin="4">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="24">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="16" Height="16" CornerRadius="2" Background="{Binding ColorBrush}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Obje" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn Header="Tur" Width="70" DisplayMemberBinding="{Binding StitchType}"/>
                                        <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Count}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB: AYARLAR -->
                    <TabItem Header="Ayarlar">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                            <StackPanel>
                                <TextBlock Text="KUMAS AYARLARI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,8"/>

                                <Label Content="Kumas Turu:"/>
                                <ComboBox x:Name="cmbFabric" Margin="2">
                                    <ComboBoxItem Content="Pamuklu (Woven Cotton)" IsSelected="True"/>
                                    <ComboBoxItem Content="Orme / Suprem"/>
                                    <ComboBoxItem Content="Spandex / Lycra"/>
                                    <ComboBoxItem Content="Kot / Denim"/>
                                    <ComboBoxItem Content="Deri"/>
                                </ComboBox>

                                <Label Content="Esneklik (α):"/>
                                <TextBox x:Name="txtAlpha" Text="0.04" IsReadOnly="True"/>

                                <Label Content="Iplik Gerilimi (β mm):"/>
                                <TextBox x:Name="txtBeta" Text="0.15" IsReadOnly="True"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="DIKIS AYARLARI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,8,0,6"/>

                                <Label Content="Dikis Adimi (mm):"/>
                                <TextBox x:Name="txtStitchLength" Text="0.4"/>

                                <Label Content="Maksimum Adim (mm):"/>
                                <TextBox Text="12.1" IsReadOnly="True"/>

                                <Label Content="Minimum Adim (mm):"/>
                                <TextBox Text="0.4" IsReadOnly="True"/>

                                <Label Content="Yoğunluk (dikis/mm):"/>
                                <TextBox x:Name="txtDensity" Text="2.5"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="PULL COMPENSATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" Margin="0,8,0,6"/>

                                <Label Content="Genisletme (mm):"/>
                                <TextBox x:Name="txtPullComp" Text="0.3"/>

                                <Label Content="Push Katsayisi:"/>
                                <TextBox x:Name="txtPushFactor" Text="0.05"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="MAKINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentRed}" Margin="0,8,0,6"/>

                                <Label Content="Atlama Kesme Esigi (mm):"/>
                                <TextBox x:Name="txtJumpThreshold" Text="2.5"/>

                                <Label Content="Atlama Sayisi (Trim):"/>
                                <ComboBox x:Name="cmbTrimCount" Margin="2">
                                    <ComboBoxItem Content="3" IsSelected="True"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="7"/>
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- ===== CENTER: CANVAS ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <!-- CANVAS -->
                <Border Grid.Row="0" Background="#0D0D1A" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- Placeholder -->
                        <TextBlock x:Name="canvasPlaceholder" 
                                   Text="DST dosyasi acin veya yeni proje olusturun&#x0a;&#x0a;Ctrl+O ile dosya acin&#x0a;Ctrl+N ile yeni proje olusturun" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" FontSize="14" TextAlignment="Center"/>
                        
                        <!-- Design Canvas -->
                        <Canvas x:Name="designCanvas" Background="Transparent" Visibility="Hidden"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                                MouseMove="Canvas_MouseMove"
                                MouseWheel="Canvas_MouseWheel"
                                MouseRightButtonDown="Canvas_MouseRightButtonDown"
                                MouseRightButtonUp="Canvas_MouseRightButtonUp">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="canvasScale" CenterX="0" CenterY="0"/>
                                    <TranslateTransform x:Name="canvasTranslate"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>

                        <!-- Rulers (Top + Left) -->
                        <Border DockPanel.Dock="Top" Height="20" Background="{StaticResource BgDark}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                            <Canvas x:Name="rulerTop" ClipToBounds="True"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- LOG PANEL -->
                <Border Grid.Row="1" Background="{StaticResource BgDark}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource BgMedium}" Padding="8,4">
                            <Grid>
                                <TextBlock Text="ISLEM LOGU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                <Button Content="Temizle" HorizontalAlignment="Right" Click="OnClearLog" Width="55" FontSize="9" Padding="4,2"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="logScroll" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="txtLog" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" 
                                       FontFamily="Consolas" FontSize="11" Margin="8,4"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== RIGHT PANEL: PROPERTIES ===== -->
            <Border Grid.Column="3" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0">
                <TabControl>
                    <!-- TAB: OBJECT PROPERTIES -->
                    <TabItem Header="Ozellikler">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                            <StackPanel>
                                <TextBlock Text="NESNE OZELLIKLERI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,8"/>

                                <Label Content="Dikis Tipi:"/>
                                <ComboBox x:Name="cmbStitchType" Margin="2">
                                    <ComboBoxItem Content="Saten" IsSelected="True"/>
                                    <ComboBoxItem Content="Tatami"/>
                                    <ComboBoxItem Content="Cizgi (Run)"/>
                                    <ComboBoxItem Content="Zigzag"/>
                                    <ComboBoxItem Content="Motif"/>
                                </ComboBox>

                                <Label Content="Kalinlik (mm):"/>
                                <TextBox x:Name="txtStitchWidth" Text="4.0"/>

                                <Label Content="Yoğunluk (dikis/mm):"/>
                                <TextBox x:Name="txtObjDensity" Text="2.5"/>

                                <Label Content="Acı (derece):"/>
                                <TextBox x:Name="txtStitchAngle" Text="45"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="KONUM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,8,0,6"/>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox Grid.Column="1" x:Name="txtPosX" Text="0.0"/>
                                    <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox Grid.Column="3" x:Name="txtPosY" Text="0.0"/>
                                </Grid>

                                <Label Content="Genislik (mm):"/>
                                <TextBox x:Name="txtObjWidth" IsReadOnly="True"/>

                                <Label Content="Yukseklik (mm):"/>
                                <TextBox x:Name="txtObjHeight" IsReadOnly="True"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="AKILLI KOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" Margin="0,8,0,6"/>

                                <CheckBox x:Name="chkSmartCorner" Content="Smart Corner Aktif" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkMiterCorner" Content="Mitered Corner" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkLapJoint" Content="Lap Joint" Margin="0,4"/>
                                <CheckBox x:Name="chkStaggeredPitch" Content="Staggered Pitching" IsChecked="True" Margin="0,4"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="KUMAS TELAFISI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentRed}" Margin="0,8,0,6"/>

                                <CheckBox x:Name="chkPullComp" Content="Pull Compensation" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkPushComp" Content="Push Compensation" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkUnderlay" Content="Alt Dikisi (Underlay)" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkSolvy" Content="Solvy Topping" Margin="0,4"/>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="OPTIMIZASYON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,6"/>

                                <CheckBox x:Name="chkMicroStitchFilter" Content="Mikro Dikis Filtresi (0.4mm)" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkAutoTieOff" Content="Otomatik Dugum (Tie-Off)" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkAutoTrim" Content="Otomatik Kesim (Trim)" IsChecked="True" Margin="0,4"/>
                                <CheckBox x:Name="chkDeltaSplit" Content="Delta Splitting (12.1mm)" IsChecked="True" Margin="0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB: STITCH LIST -->
                    <TabItem Header="Dikis Listesi">
                        <DockPanel>
                            <TextBox x:Name="txtSearch" DockPanel.Dock="Top" 
                                     Margin="8,8,8,4" Padding="4"
                                     Background="{StaticResource BgInput}" Foreground="White" BorderBrush="{StaticResource BorderDark}"
                                     TextChanged="OnSearchChanged"/>
                            
                            <ListView x:Name="lstStitches" SelectionChanged="OnStitchSelected">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="#" Width="50" 
                                            DisplayMemberBinding="{Binding Index}"/>
                                        <GridViewColumn Header="Tur" Width="75" 
                                            DisplayMemberBinding="{Binding TypeName}"/>
                                        <GridViewColumn Header="dX" Width="45" 
                                            DisplayMemberBinding="{Binding DeltaX}"/>
                                        <GridViewColumn Header="dY" Width="45" 
                                            DisplayMemberBinding="{Binding DeltaY}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB: THREAD PALETTE -->
                    <TabItem Header="Iplikler">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                            <StackPanel>
                                <TextBlock Text="IPLIK PALETI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,4,0,8"/>
                                
                                <TextBlock Text="Aktif Palet: Madeira Polyneon" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>

                                <ItemsControl x:Name="threadPalette">
                                    <ItemsControl.Items>
                                        <Border Background="#FF0000" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#0000FF" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#00AA00" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#FFD700" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#FF6600" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#800080" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#8B4513" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#000000" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#FFFFFF" Height="28" Margin="0,1" CornerRadius="2" BorderBrush="#444"/>
                                        <Border Background="#FF69B4" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#00CED1" Height="28" Margin="0,1" CornerRadius="2"/>
                                        <Border Background="#FF4500" Height="28" Margin="0,1" CornerRadius="2"/>
                                    </ItemsControl.Items>
                                </ItemsControl>

                                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,10"/>

                                <TextBlock Text="OZEL RENK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,8,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RGB:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox Grid.Column="1" x:Name="txtCustomColor" Width="100" Text="#FF0000"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="3" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <Grid Margin="8,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Text="Hazir - DST dosyasi acin veya yeni proje olusturun" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <TextBlock Grid.Column="1" x:Name="txtCoords" Text="X: 0.0  Y: 0.0" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" Margin="20,0"/>
                <TextBlock Grid.Column="2" x:Name="txtStitchInfo" Text="" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="20,0"/>
                <TextBlock Grid.Column="3" x:Name="txtZoomStatus" Text="100%" Foreground="{StaticResource AccentGreen}" FontSize="11" Margin="20,0"/>
                <TextBlock Grid.Column="4" Text="NakisCAD v1.0" Foreground="{StaticResource TextMuted}" FontSize="10"/>
            </Grid>
        </Border>

        <!-- ==================== COLOR BAR (Bottom Thread Palette) ==================== -->
        <Border Grid.Row="4" Background="{StaticResource BgMedium}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="RENK" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="colorBar" Orientation="Horizontal" Margin="4,3">
                        <!-- Colors populated dynamically -->
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
